# ─── SYNQ: пример конфигурации ───────────────────────────────────────
# Скопируйте в .env и заполните своими значениями. Файл .env в Git не публикуется.

NODE_ENV=development
PORT=4000

# PostgreSQL: рабочая база и ВРЕМЕННАЯ база для автотестов
# (npm test создаёт её перед запуском и удаляет после; имя должно оканчиваться на _test)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/synq?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/synq_test?schema=public"

# JWT: случайная строка не короче 32 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Разрешённые origin для CORS (через запятую)
CORS_ORIGIN=http://localhost:4000

# Supabase Storage (Project Settings → API). Service Role Key — только на сервере!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGES_BUCKET=product-images
SUPABASE_FILES_BUCKET=product-files
# Время жизни подписанной ссылки на скачивание, секунд
SIGNED_URL_TTL=120

# Необязательно: учётная запись владельца магазина для `npm run db:seed`
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
